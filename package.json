{
  "name": "netflix-clone",
  "version": "2.0.0",
  "description": "Netflix Clone — React (Vite) front end with an Express TMDB proxy + auth backend",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"node server.js\" \"vite\"",
    "dev:server": "node server.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server.js",
    "preview": "npm run build && node server.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^5.4.11"
  }
}
